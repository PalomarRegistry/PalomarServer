{
  "name": "palomar-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:preflight": "esbuild browser/preflight.js --bundle --format=esm --platform=browser --minify --legal-comments=external --outfile=public/preflight.js",
    "predev": "npm run build:preflight",
    "pretest": "npm run build:preflight",
    "pretest:runtime": "npm run build:preflight",
    "predeploy": "npm run build:preflight",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.js",
    "test:runtime": "vitest run",
    "audit:dependencies": "npm audit --package-lock-only --audit-level=low",
    "deploy": "wrangler deploy",
    "deploy:redirect": "wrangler deploy --config redirect/wrangler.jsonc",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "vitest": "4.1.10",
    "wrangler": "4.120.0",
    "yaml": "2.9.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palomar-server",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // Admission slots are freed here rather than when a submitter's page polls,
  // so a closed tab cannot hold one forever.
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "submit.palomar-registry.org/*", "zone_name": "palomar-registry.org" }],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Refuses an intake before it can spend a GitHub call, so a loop against the
  // unauthenticated endpoints cannot exhaust the tokens the whole pipeline
  // shares. Counted per data centre and keyed on an address, so it shapes cost
  // rather than deciding who may submit; the pending ceiling in the code is
  // what actually bounds the damage. Five a minute is far above what a person
  // filling in the form reaches and far below what a script wants.
  "ratelimits": [
    { "name": "INTAKE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "SUBMISSION_REPO": "PalomarRegistry/PalomarSubmission",
    "STATE_REPO": "PalomarRegistry/PalomarSubmissionState",
    "VERIFY_WORKFLOW": "submission.yml",
    "REVIEW_WORKFLOW": "reviewer.yml",
    "SITE_URL": "https://palomar-registry.org"
  }
}

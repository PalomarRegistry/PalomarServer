{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palomar-server",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Admission slots are freed here rather than when a submitter's page polls,
  // so a closed tab cannot hold one forever.
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "submit.palomar-registry.org/*", "zone_name": "palomar-registry.org" }],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Refuses an intake before it can spend a GitHub call, so a loop against the
  // unauthenticated endpoints costs the attacker addresses rather than costing
  // Palomar the tokens the whole pipeline shares. Counted per data centre and
  // keyed on an address, so enough addresses still get through: this shapes the
  // rate, it does not decide who may submit. Five a minute is far above what a
  // person filling in the form reaches and far below what a script wants.
  // Intake refuses outright if this binding is missing, so removing it here
  // takes the submission service down rather than quietly widening it.
  "ratelimits": [
    { "name": "INTAKE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "SUBMISSION_REPO": "PalomarRegistry/PalomarSubmission",
    "STATE_REPO": "PalomarRegistry/PalomarSubmissionState",
    "VERIFY_WORKFLOW": "submission.yml",
    "REVIEW_WORKFLOW": "reviewer.yml",
    "REPAIR_WORKFLOW": "repairer.yml",
    "SITE_URL": "https://palomar-registry.org"
  }
}

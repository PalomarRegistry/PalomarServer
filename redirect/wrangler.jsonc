{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "palomar-domain-redirect",
  "main": "index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "palomarregistry.org", "custom_domain": true },
    { "pattern": "www.palomarregistry.org", "custom_domain": true }
  ]
}
